FROM python:3.12-slim

# Patch OS-package CVEs inherited from the base image (Trivy gate in CI fails
# on HIGH/CRITICAL — without this the image carries the libcap2/libsystemd0/
# libudev1 fixes published in deb13u1 only after the base image was last cut).
RUN apt-get update \
 && apt-get -y upgrade \
 && rm -rf /var/lib/apt/lists/*

# Pin a specific OS user so file ownership is deterministic across hosts.
# UID 10001 is high enough to never collide with system users.
RUN groupadd --system --gid 10001 appuser \
 && useradd  --system --uid 10001 --gid 10001 --create-home appuser

WORKDIR /app

COPY --chown=appuser:appuser requirements.txt .
# hadolint ignore=DL3008
RUN pip install --no-cache-dir -r requirements.txt

COPY --chown=appuser:appuser . .

EXPOSE 5000

USER appuser

CMD ["gunicorn", "--workers", "3", "--threads", "2", "--bind", "0.0.0.0:5000", "minitwit_refactor:app"]
