# Terraform local state — contains secrets (SSH keys, tokens, DO API
# responses). Never commit. Use a remote backend if you need team sharing
# (see versions.tf).
*.tfstate
*.tfstate.*
*.tfstate.backup

# Local plan output — also contains resolved variable values.
*.tfplan

# Per-developer overrides.
terraform.tfvars
*.auto.tfvars

# Provider plugins and module cache.
.terraform/
.terraform.lock.hcl

# Worker join token, written by the manager's local-exec provisioner.
.tokens/
