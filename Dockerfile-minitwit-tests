FROM python:3.12-slim

RUN groupadd --system --gid 10001 appuser \
 && useradd  --system --uid 10001 --gid 10001 --create-home appuser

WORKDIR /app

COPY --chown=appuser:appuser requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt pytest requests

COPY --chown=appuser:appuser . .

USER appuser

CMD ["pytest", "minitwit_tests_refactor.py", "minitwit_sim_api_test.py", "test_itu_minitwit_ui.py"]
