      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "rate(node_disk_io_time_seconds_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "{{instance}} {{device}}",
          "refId": "A"
        }
      ],
      "title": "Disk I/O utilisation",
      "type": "timeseries"
